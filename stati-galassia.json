      "se_spenta": {
        "vietato_link": "radio-anima\\.pages\\.dev",
        "vietato_testo": "radio[^.]{0,80}?\\b(attiva|accesa|suona|sintonizzati|in prova)\\b"
      },
      "se_accesa": {
        "vietato_testo": "radio[^.]{0,80}?\\b(in accordatura|in prova|spenta)\\b"
      }
    },
    "aura-pubblica": {
      "stato": "in allestimento",
      "pagina": "systema77.com/aura.html",
      "perche": "le due rotte del Worker sono dichiarate e spente",
      "se_in_allestimento": {
        "vietato_testo": "\\baura\\b[^.]{0,40}?\\b(è acces[ao]|funziona già|è online)\\b"
      }
    },
    "verifiche": {
      "stato": "attiva",
      "pagina": "animagame.io/verifiche.html",
